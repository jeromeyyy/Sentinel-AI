{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelAI Multi-Tenant Data Structure",
  "description": "JSON file structure for multi-tenant camera surveillance system",
  "version": "1.0.0",
  
  "tenant": {
    "type": "object",
    "required": ["id", "name", "module", "created_at"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique tenant identifier",
        "example": "tenant_abc123"
      },
      "name": {
        "type": "string",
        "description": "Organization or tenant name",
        "example": "Lincoln High School"
      },
      "module": {
        "type": "string",
        "enum": ["home", "school", "office"],
        "description": "Surveillance module type"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "description": "Tenant creation timestamp"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "settings": {
        "type": "object",
        "properties": {
          "alert_email": { "type": "string", "format": "email" },
          "alert_threshold": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "recording_enabled": { "type": "boolean" },
          "retention_days": { "type": "integer", "minimum": 1, "maximum": 365 }
        }
      },
      "users": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "role": { "type": "string", "enum": ["admin", "operator", "viewer"] },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  },

  "camera": {
    "type": "object",
    "required": ["id", "tenant_id", "name", "zone", "source", "created_at"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique camera identifier",
        "example": "cam_corridor_01"
      },
      "tenant_id": {
        "type": "string",
        "description": "Associated tenant ID"
      },
      "name": {
        "type": "string",
        "description": "Human-readable camera name",
        "example": "Main Corridor - East Wing"
      },
      "zone": {
        "type": "string",
        "enum": ["outgate", "corridor", "school_ground", "classroom"],
        "description": "Surveillance zone type"
      },
      "source": {
        "type": "string",
        "description": "RTSP URL or video file path",
        "example": "rtsp://192.168.1.100:554/stream"
      },
      "active": {
        "type": "boolean",
        "default": true
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "location": { "type": "string" },
          "floor": { "type": "string" },
          "building": { "type": "string" },
          "model": { "type": "string" },
          "resolution": { "type": "string" },
          "fps": { "type": "integer" }
        }
      },
      "health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["online", "offline", "error"] },
          "last_checked": { "type": "string", "format": "date-time" },
          "uptime_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  },

  "incident": {
    "type": "object",
    "required": ["id", "tenant_id", "camera_id", "event_type", "timestamp"],
    "properties": {
      "id": {
        "type": "string",
        "example": "inc_20260218_001"
      },
      "tenant_id": {
        "type": "string"
      },
      "camera_id": {
        "type": "string"
      },
      "event_type": {
        "type": "string",
        "enum": [
          "fight_detected",
          "crowd_formation",
          "weapon_detected",
          "gate_accident",
          "mobile_phone_usage",
          "unauthorized_entry",
          "loitering",
          "vehicle_speeding"
        ]
      },
      "zone": {
        "type": "string"
      },
      "timestamp": {
        "type": "number",
        "description": "Unix timestamp"
      },
      "priority": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"]
      },
      "resolved": {
        "type": "boolean",
        "default": false
      },
      "resolved_at": {
        "type": "string",
        "format": "date-time"
      },
      "resolved_by": {
        "type": "string"
      },
      "frame_url": {
        "type": "string",
        "description": "URL to incident frame image"
      },
      "video_clip_url": {
        "type": "string",
        "description": "URL to incident video clip"
      },
      "summary": {
        "type": "string",
        "description": "Brief incident description"
      },
      "llm_explanation": {
        "type": "string",
        "description": "AI-generated detailed explanation"
      },
      "recommended_action": {
        "type": "string",
        "description": "Suggested response action"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "person_count": { "type": "integer" },
          "object_count": { "type": "integer" },
          "confidence": { "type": "number" },
          "detection_model": { "type": "string" },
          "processing_time_ms": { "type": "number" }
        }
      },
      "actions_taken": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["viewed", "resolved", "exported", "escalated"] },
            "user_id": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
