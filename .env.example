# ============================================================================
# SENTINEL AI - ENVIRONMENT CONFIGURATION
# ============================================================================

# Database (MongoDB Atlas)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sentinelai?retryWrites=true&w=majority

# Authentication
JWT_SECRET=generate_a_random_32_character_secret_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Notifications (WhatsApp & SMS via Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFICATION_PHONE_NUMBER=+1234567890

# Optional AI LLM Summaries
OPENAI_API_KEY=sk-...

# Frontend Environment Variables (in frontend/.env.local or production config)
NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.com
NEXT_PUBLIC_WS_URL=wss://your-backend-domain.com/ws/alerts


# ---- Detection pipeline (backend/pipeline/config.py) ------------------------
MODEL_PATH=models/yolov8n.pt        # .pt, or .onnx exported with scripts/export_onnx.py at the same IMGSZ
IMGSZ=480                           # 416-640; smaller = faster
CONF=0.35                           # base confidence (phones use PHONE_CONF=0.25)
IOU=0.5
FRAME_SKIP=3                        # run inference every Nth captured frame; in-between frames reuse last tracks
STREAM_FPS=15                       # cap on frames sent to browsers
STREAM_MAX_WIDTH=960
JPEG_QUALITY=75
INFER_MAX_WIDTH=640                 # frames are downscaled to this before inference, boxes scaled back
DEVICE=cpu                          # "0" for CUDA
ENABLE_EXTRA_DETECTORS=1            # fire/smoke + weapon models (set 0 on small instances)
PIPELINE_AUTOSTART=1                # 0 = start a camera on first viewer
IDLE_STOP_SECONDS=0                 # >0 stops cameras nobody watches
CLEAN_STREAM=0                      # 1 = plain video + canvas boxes over /ws/detections/{id}
CROWD_MIN_PEOPLE=5
CROWD_SECONDS=3
FIGHT_SECONDS=1.5
STOPPED_SECONDS=2
FRONTEND_URL=*                      # prod: https://your-app.vercel.app (comma separate several)
CORS_ORIGIN_REGEX=                  # optional, e.g. https://sentinel-ai-.*\.vercel\.app for preview deploys

# Incident snapshot links are HMAC-signed and expire. Set a stable secret so links survive restarts.
SNAPSHOT_SECRET=
SNAPSHOT_URL_TTL_S=3600
SNAPSHOT_RETENTION_DAYS=7

# Torch-free mode: MODEL_PATH=models/yolov8n.onnx (see backend/Dockerfile.lite). Extra detectors must be 0.
