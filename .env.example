# ============================================================================
# SENTINEL AI - ENVIRONMENT CONFIGURATION
# ============================================================================

# Database (MongoDB Atlas)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sentinelai?retryWrites=true&w=majority

# Authentication
JWT_SECRET=generate_a_random_32_character_secret_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Notifications (WhatsApp & SMS via Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFICATION_PHONE_NUMBER=+1234567890

# Optional AI LLM Summaries
OPENAI_API_KEY=sk-...

# Frontend Environment Variables (in frontend/.env.local or production config)
NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.com
NEXT_PUBLIC_WS_URL=wss://your-backend-domain.com/ws/alerts
