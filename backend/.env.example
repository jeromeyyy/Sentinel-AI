# ============================================================================
# SentinelAI Environment Variables Example
# ============================================================================
# NOTE: The actual .env file should be placed in the PROJECT ROOT directory
# (SecVidA/.env), NOT in the backend folder. Both backend and worker load
# from the centralized root .env file.
# ============================================================================

# Server port (Render uses 10000 by default)
PORT=8000

# Active module (home, school, office)
MODULE=school

# Frontend URL for CORS (set to your Vercel domain in production)
# Use * for development to allow all origins
FRONTEND_URL=*

# LLM API Configuration (optional - for AI summaries)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Twilio WhatsApp Notifications ───────────────────────────────────────────
# Get credentials from: https://console.twilio.com
# For Sandbox setup: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
#
# Steps to set up Twilio WhatsApp Sandbox:
# 1. Create a Twilio account at https://www.twilio.com/try-twilio
# 2. Go to Messaging > Try it out > Send a WhatsApp message
# 3. Join the sandbox by sending the code to the Twilio number
# 4. Copy your Account SID and Auth Token from the Twilio Console
# 5. Set TWILIO_WHATSAPP_TO to your WhatsApp number (e.g., whatsapp:+91XXXXXXXXXX)
#
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_WHATSAPP_TEMPLATE_VARS={}
WHATSAPP_ALERTS_ENABLED=false

# Fallback Twilio account (optional)
TWILIO_FALLBACK_ACCOUNT_SID=
TWILIO_FALLBACK_AUTH_TOKEN=
TWILIO_FALLBACK_WHATSAPP_FROM=
TWILIO_FALLBACK_WHATSAPP_TO=
TWILIO_FALLBACK_WHATSAPP_TEMPLATE_SID=
TWILIO_FALLBACK_WHATSAPP_TEMPLATE_VARS={}
WHATSAPP_FALLBACK_ENABLED=false

# Auto-discover test videos
AUTO_DISCOVER_TEST_VIDEOS=1
